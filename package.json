{
  "name": "planet-of-climate",
  "private": true,
  "version": "6.0.0",
  "description": "Climate Planet V6 — source-attributed meteorological maps, city-specific daily cards, 2 tested science games",
  "type": "module",
  "scripts": {
    "build": "node scripts/sync-cities.mjs && node scripts/build.mjs",
    "build:offline": "node scripts/build.mjs",
    "cities": "node scripts/sync-cities.mjs",
    "preview": "npx serve dist",
    "archive:seed": "node scripts/create-jerusalem.mjs",
    "maps:help": "python tools/render_map.py --help",
    "test": "python tests/test_v6_static.py"
  },
  "engines": {
    "node": ">=18"
  }
}
